# Frontend build-time configuration (Vite). Copy to .env for local dev.
# On deploy these are injected automatically from CDK stack outputs by
# cdk/scripts/deploy-frontend.sh — you normally do NOT hand-edit them.

# Cognito (CDK outputs: UserPoolId / UserPoolClientId / IdentityPoolId)
VITE_COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_IDENTITY_POOL_ID=us-east-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AWS Region
VITE_AWS_REGION=us-east-2

# S3 buckets — CDK auto-generates the names; injected from stack outputs
# (SequencesBucketName / ModelsBucketName). Leave blank for local dev.
VITE_SEQUENCES_BUCKET=
VITE_MODELS_BUCKET=

# Backend API URL (CDK output: ApiEndpoint). Default for local dev:
VITE_BACKEND_URL=http://localhost:8000

# NOTE: the PCR trust store now lives in the browser (localStorage), not SSM —
# there is no trust-store path to configure here.
