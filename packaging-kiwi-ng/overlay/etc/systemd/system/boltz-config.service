[Unit]
Description=Boltz backend runtime configuration (fetch CORS_ORIGINS from SSM)
Documentation=https://github.com/aws-samples/sample-mpc-biomodel-ec2-instance-attestation
# Needs the network + instance IAM credentials to reach the SSM VPC endpoint.
After=network-online.target
Wants=network-online.target
# Must complete before the backend starts so boltz-backend reads the freshly
# written EnvironmentFile (/etc/boltz/environment).
Before=boltz-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/boltz/bin/write-runtime-config.py

[Install]
WantedBy=multi-user.target
